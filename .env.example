# Copy to .env — never commit real values. All values below are dev defaults.
COMPOSE_PROJECT_NAME=rento-dev
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://rento:rento@localhost:5441/rento
TEST_DATABASE_URL=postgresql+asyncpg://rento:rento@localhost:5441/rento_test
REDIS_URL=redis://localhost:6391/0
S3_ENDPOINT_URL=http://localhost:9110
S3_PUBLIC_ENDPOINT_URL=http://localhost:9110
S3_ACCESS_KEY=rentominio
S3_SECRET_KEY=rentominio-dev-secret
S3_BUCKET=rento
S3_REGION=us-east-1
JWT_SECRET=dev-only-change-me-dev-only-change-me
LINK_SECRET=dev-only-link-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TIMEZONE=Asia/Tashkent
APP_BASE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010
