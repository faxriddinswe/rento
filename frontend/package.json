{
  "name": "rento-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "gen:api": "cd ../backend && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi()))\" > ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
